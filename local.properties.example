## Copy to local.properties and set your keys
## sdk.dir is usually auto-generated by Android Studio
# sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

# Required for map tiles + Directions API routes
MAPS_API_KEY=your_google_maps_api_key_here

# Required for live Groq Llama AI planner (free tier)
GROQ_API_KEY=your_groq_api_key_here
